# ==============================================================================
# BTN HRMS — Root Environment Configuration Example (Docker Compose & Infra)
# ==============================================================================

# 1. System & Timezone Settings
TZ=Asia/Ho_Chi_Minh
APP_TIMEZONE=Asia/Ho_Chi_Minh
NEXT_PUBLIC_TIMEZONE=Asia/Ho_Chi_Minh
HOST_IP=127.0.0.1

# 2. Database Configuration (PostgreSQL - docker-compose.infra.yml)
POSTGRES_USER=hrms
POSTGRES_DB=hrms
POSTGRES_PASSWORD=your_postgres_password_here

# 3. Object Storage Configuration (MinIO S3 - docker-compose.infra.yml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

# 4. Security & Cryptography Keys (docker-compose.yml)
AUTH_JWT_SECRET=your_jwt_secret_at_least_32_characters_long
AUTH_JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_long
AUTH_DEFAULT_PASSWORD=BtnHrms2025!@#
PII_ENCRYPTION_KEY=your_pii_encryption_key_here

# 5. Routing & Deployment Configuration (docker-compose.yml)
APP_URL=https://btn.hieutt.id.vn
FRONTEND_URL=http://127.0.0.1:8080
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# 6. Attendance Feature Flags
ATTENDANCE_STRICT_FACE_DETECTION=false
ATTENDANCE_FACE_VERIFICATION_MODE=flagged
