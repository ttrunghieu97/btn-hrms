# ==============================================================================
# BTN HRMS — Frontend Web Environment Configuration Example (apps/web)
# ==============================================================================

# 1. Runtime & Server
NODE_ENV=development
PORT=8080
HOSTNAME=0.0.0.0
BUILD_STANDALONE=true

# 2. API Endpoints
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1
INTERNAL_API_URL=http://127.0.0.1:3001

# 3. Timezone & Allowed Dev Origins
NEXT_PUBLIC_TIMEZONE=Asia/Ho_Chi_Minh
ALLOWED_DEV_ORIGINS=

# 4. Edge Session & Cookie Verification
AUTH_COOKIE_SECRET=your_jwt_secret_at_least_32_characters_long
AUTH_JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# 5. Observability (Optional)
NEXT_PUBLIC_SENTRY_DISABLED=true
NEXT_PUBLIC_SENTRY_DSN=
