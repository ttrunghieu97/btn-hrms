# ==============================================================================
# BTN HRMS — Frontend Web Environment Configuration Example (apps/web)
# ==============================================================================
# Copy to `apps/web/.env` for local frontend development.
# Client vars (`NEXT_PUBLIC_*`) are validated by `apps/web/src/lib/env.client.ts`.
# Server/Edge vars are validated by `apps/web/src/lib/env.server.ts`.

# 1. Runtime & Build Configuration
NODE_ENV=development
PORT=8080
HOSTNAME=0.0.0.0
BUILD_STANDALONE=true
NEXT_CPUS=

# 2. API Endpoints (Client vs Server-side Internal)
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://127.0.0.1:3001

# 3. Timezone, Allowed Dev Origins & Progressive Module Rollout
NEXT_PUBLIC_TIMEZONE=Asia/Ho_Chi_Minh
ALLOWED_DEV_ORIGINS=
NEXT_PUBLIC_ENABLED_MODULES=
ENABLED_NAV_GROUPS=

# 4. Edge Session & Cookie Verification (Server-only — never expose to client)
AUTH_COOKIE_SECRET=your_jwt_access_secret_at_least_32_characters_long
AUTH_JWT_SECRET=your_jwt_access_secret_at_least_32_characters_long
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token

# 5. Client Feature Flags & Integrations (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_STORAGE_ENDPOINT=
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEBUG=false

# 6. Observability & Performance Telemetry (Optional)
NEXT_PUBLIC_SENTRY_DISABLED=true
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_TRACING_ENABLED=false
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
NEXT_PUBLIC_WEB_VITALS_ENABLED=false
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
NEXT_PUBLIC_PERFORMANCE_MONITORING_ENABLED=false
NEXT_PUBLIC_PERFORMANCE_METRICS_ENDPOINT=
