{
  "extends": "@project/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": false,
    "allowJs": true,
    "ignoreDeprecations": "5.0",
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
