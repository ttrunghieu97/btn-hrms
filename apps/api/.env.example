# ==============================================================================
# BTN HRMS — Backend API Environment Configuration Example (apps/api)
# ==============================================================================

# 1. Runtime & Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=1
APP_URL=http://localhost:3001
APP_TIMEZONE=Asia/Ho_Chi_Minh

# 2. Feature & Bootstrap Flags (validated by validateEnv)
FEATURE_DB_VERIFY=true
FEATURE_SWAGGER=false
FEATURE_VAULT=false
FEATURE_REDIS_EVENT_BUS=false

# 3. Database (PostgreSQL)
DATABASE_URL=postgres://hrms:your_postgres_password_here@127.0.0.1:5432/hrms
DATABASE_DIRECT_URL=postgres://hrms:your_postgres_password_here@127.0.0.1:5432/hrms

# 4. Storage (MinIO / S3 — parsed by StorageConfigService from STORAGE_S3_URL)
STORAGE_BACKEND=s3
STORAGE_BUCKET=btn-hrms
STORAGE_S3_URL=http://minioadmin:your_minio_password_here@127.0.0.1:9002?region=us-east-1&forcePathStyle=true
STORAGE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9002
STORAGE_SIGNED_URL_TTL_SEC=300
STORAGE_PUBLIC_CDN_ENABLED=false

# 5. Auth & Cryptography (validated by validateEnv)
AUTH_JWT_SECRET=your_jwt_secret_at_least_32_characters_long
AUTH_JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_long
AUTH_DEFAULT_PASSWORD=BtnHrms2025!@#
AUTH_COOKIE_SECURE=false
PII_ENCRYPTION_KEY=your_pii_encryption_key_here

# 6. Observability (Optional)
OBSERVABILITY_SENTRY_DSN=
OBSERVABILITY_SENTRY_TRACES_SAMPLE_RATE=0.1
OBSERVABILITY_OTEL_SERVICE_NAME=btn-hrms-api
OBSERVABILITY_OTEL_URL=

# 7. Database Reset / Seed & Attendance Policy
ALLOW_DB_RESET=false
ALLOW_REMOTE_DB_RESET=false
SEED_PASSWORD=123456
ATTENDANCE_STRICT_FACE_DETECTION=false
ATTENDANCE_FACE_VERIFICATION_MODE=flagged
