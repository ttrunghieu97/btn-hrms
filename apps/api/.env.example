# ==============================================================================
# BTN HRMS — Backend API Environment Configuration Example (apps/api)
# ==============================================================================
# Copy to `apps/api/.env` for local backend development.
# Validated at startup by `validateEnv` (`apps/api/src/shared/config/validate-env.ts`).

# 1. Runtime, Server & Origin Protection
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=1
TRUSTED_PROXY_IPS=
MAX_REQUEST_BODY_KB=512
TENANT_ID=00000000-0000-0000-0000-000000000000
TZ=Asia/Ho_Chi_Minh
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:3001
FRONTEND_URL=http://127.0.0.1:8080
CORS_ORIGIN=
ALLOWED_DEV_ORIGINS=

# 2. Feature, Bootstrap & Module Rollout Flags
FEATURE_DB_VERIFY=true
FEATURE_SWAGGER=false
FEATURE_VAULT=false
FEATURE_REDIS_EVENT_BUS=false
ENABLED_NAV_GROUPS=

# 3. Database (PostgreSQL)
DATABASE_URL=postgres://hrms:your_postgres_password_here@127.0.0.1:5432/hrms
DATABASE_DIRECT_URL=postgres://hrms:your_postgres_password_here@127.0.0.1:5432/hrms

# 4. Redis & Durable Event Bus / Cache (Optional unless FEATURE_REDIS_EVENT_BUS=true in prod)
REDIS_URL=
EVENT_BUS_STREAM_KEY=
EVENT_BUS_DLQ_STREAM_KEY=
EVENT_BUS_CONSUMER_GROUP=hrms-api
EVENT_BUS_STREAM_MAXLEN=10000
EVENT_BUS_MAX_RETRIES=5
EVENT_BUS_RECLAIM_IDLE_MS=60000
EVENT_BUS_RECLAIM_COUNT=20
PERMISSIONS_CACHE_TTL=300
PERMISSIONS_CACHE_MAX=1000

# 5. Storage & Virus Scanning (MinIO / S3 — parsed by StorageConfigService)
STORAGE_BACKEND=s3
STORAGE_BUCKET=btn-hrms
STORAGE_S3_URL=http://minioadmin:your_minio_password_here@127.0.0.1:9002?region=us-east-1&forcePathStyle=true
STORAGE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9002
STORAGE_SIGNED_URL_TTL_SEC=300
STORAGE_PUBLIC_CDN_ENABLED=false
STORAGE_FINALIZE_RETRY_INTERVAL_MS=120000
UPLOAD_MAX_MB=10
UPLOAD_MULTIPART_MAX_BYTES=
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_FAIL_CLOSED=false
SCAN_QUEUE_INTERVAL_MS=15000

# 6. Auth, Sessions, SSO & Cryptography
AUTH_JWT_SECRET=your_jwt_access_secret_at_least_32_characters_long
AUTH_JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_long
AUTH_JWT_ACCESS_EXPIRES_IN=15m
AUTH_DEFAULT_PASSWORD=BtnHrmsDefaultPass!@#
AUTH_BCRYPT_ROUNDS=12
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_TOKEN_CLEANUP_ENABLED=true
AUTH_REFRESH_TOKEN_CLEANUP_INTERVAL_MS=60000
REFRESH_GRACE_PERIOD_MS=30000
TOTP_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
PII_ENCRYPTION_KEY=your_pii_encryption_key_at_least_32_characters_long
PII_ENCRYPTION_ACTIVE_VERSION=1

# 7. HashiCorp Vault (Required when FEATURE_VAULT=true in production)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_PATH=secret/data/btn-hrms

# 8. Integration Hub Webhooks & Outbox
WEBHOOK_SECRET=
WEBHOOK_DELIVERY_TIMEOUT_MS=30000
WEBHOOK_ALLOW_INSECURE_HTTP=false
WEBHOOK_TARGET_ALLOWLIST=
OUTBOX_MAX_CONCURRENT_PER_TYPE=25
TASK_REMINDER_INTERVAL_MS=21600000

# 9. Observability (Optional)
OBSERVABILITY_SENTRY_DSN=
OBSERVABILITY_SENTRY_TRACES_SAMPLE_RATE=0.1
OBSERVABILITY_OTEL_SERVICE_NAME=btn-hrms-api
OBSERVABILITY_OTEL_URL=

# 10. Database Reset / Seed & Attendance Policy
ALLOW_DB_RESET=false
ALLOW_REMOTE_DB_RESET=false
SEED_PASSWORD=
ATTENDANCE_STRICT_FACE_DETECTION=false
ATTENDANCE_FACE_VERIFICATION_MODE=flagged
