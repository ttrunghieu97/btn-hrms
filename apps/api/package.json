{
  "name": "@project/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "arch:check-boundaries": "node ./scripts/check-context-boundaries.mjs",
    "arch:check-registry": "node ./scripts/check-context-registry.mjs",
    "arch:check-db-access": "node ./scripts/check-direct-db-access.mjs",
    "arch:check-db-classified": "node ./scripts/check-direct-db-classified.mjs",
    "arch:check-adapter-dip": "node ./scripts/check-adapter-dip.mjs",
    "arch:check-cycles": "node ./scripts/check-module-cycles.mjs",
    "arch:graph": "node ./scripts/check-module-cycles.mjs --graph",
    "arch:check": "ARCH_MODE=enforce-new node ./scripts/check-arch-all.mjs",
    "arch:check:json": "node ./scripts/check-arch-all.mjs --json",
    "arch:check:strict": "ARCH_MODE=enforce-all node ./scripts/check-arch-all.mjs",
    "build": "nest build",
    "db:prepare": "pnpm db:migrate",
    "db:prepare:dev": "pnpm db:push",
    "dev": "nest start --watch --builder swc --config nest-cli.dev.json --path tsconfig.dev.json",
    "dev:bootstrap": "pnpm db:prepare:dev && pnpm dev",
    "error-contracts:json": "ts-node -T -r tsconfig-paths/register src/scripts/generate-error-contracts.ts",
    "error-contracts:verify": "ts-node -T -r tsconfig-paths/register src/scripts/generate-error-contracts.ts --check",
    "format": "oxfmt src test",
    "start": "nest start",
    "start:dev": "nest start --watch --builder swc --config nest-cli.dev.json --path tsconfig.dev.json",
    "start:debug": "nest start --debug --watch --builder swc --config nest-cli.dev.json --path tsconfig.dev.json",
    "start:prod": "node dist/main",
    "lint": "oxlint src",
    "lint:check": "oxlint src",
    "check": "pnpm lint:check && pnpm arch:check",
    "test": "jest --maxWorkers=3",
    "test:unit": "jest --maxWorkers=3",
    "test:watch": "jest --watch --maxWorkers=2",
    "test:cov": "jest --coverage --maxWorkers=3",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --maxWorkers=2",
    "test:schemathesis": "schemathesis run --base-url http://localhost:3001 ../web/openapi.json",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "ts-node src/infrastructure/database/seed.ts",
    "db:seed:roles": "ts-node src/infrastructure/database/seed-roles.ts",
    "db:seed:xlsx": "ts-node -T src/infrastructure/database/seed-xlsx.ts",
    "db:drop": "ts-node src/infrastructure/database/reset.ts",
    "db:reset": "pnpm db:drop && pnpm db:migrate && pnpm db:seed",
    "openapi:json": "ts-node -T -r tsconfig-paths/register src/scripts/generate-openapi.ts",
    "openapi:generate": "pnpm openapi:json ../web/openapi.json && node ./scripts/patch-openapi.mjs ../web/openapi.json",
    "arch:compat:check": "node ./scripts/check-compatibility-cleanup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@project/permissions": "workspace:*",
    "@sentry/node": "^11.4.0",
    "@smithy/node-http-handler": "^4.12.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "cache-manager": "^7.2.9",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "docx": "^9.8.1",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "js-yaml": "^5.4.3",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "multer": "^2.4.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@project/tsconfig": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "glob": "^13.0.6",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest",
        {
          "swcrc": false,
          "jsc": {
            "target": "es2021",
            "parser": {
              "syntax": "typescript",
              "decorators": true,
              "dynamicImport": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "keepClassNames": true
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.*(@nestjs|uuid)))"
    ],
    "setupFiles": [
      "../jest.setup.js"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts",
      "!app.module.ts",
      "!**/*.module.ts",
      "!**/*.interface.ts",
      "!**/*.types.ts",
      "!**/dto/**",
      "!**/mappers/**",
      "!infrastructure/database/schema/**",
      "!infrastructure/database/seed.ts",
      "!scripts/**",
      "!shared/swagger/**",
      "!shared/observability/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 40,
        "functions": 50,
        "lines": 60,
        "statements": 60
      }
    },
    "coverageReporters": [
      "json-summary",
      "lcov",
      "text",
      "clover"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
